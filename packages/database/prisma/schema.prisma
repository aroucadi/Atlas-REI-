  evaluationRuns EvaluationRun[]
  optimizationProposals OptimizationProposal[]

  @@map("test_suites")
}

model TestCase {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  suiteId      String    @map("suite_id") @db.Uuid
  inputGoal    String    @map("input_goal")
  expectedPlan Json      @default("{}") @map("expected_plan")
  goldenOutput Json      @default("{}") @map("golden_output")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  suite        TestSuite @relation(fields: [suiteId], references: [id], onDelete: Cascade)

  @@map("test_cases")
}

model EvaluationRun {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  suiteId    String    @map("suite_id") @db.Uuid
  commitSha  String    @map("commit_sha")
  metrics    Json      @default("{}") @map("metrics")
  passed     Boolean   @default(false)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  suite      TestSuite @relation(fields: [suiteId], references: [id], onDelete: Cascade)

  @@map("evaluation_runs")
}

model KernelProcess {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId     String   @map("workspace_id") @db.Uuid
  goalId          String   @map("goal_id") @db.Uuid
  status          String   @default("READY")
  priority        Int      @default(5)
  allocatedTokens Int      @default(0) @map("allocated_tokens")
  cpuLimitMs      Int      @default(5000) @map("cpu_limit_ms")
  stepLimit       Int      @default(10) @map("step_limit")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  goal            Goal      @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@map("kernel_processes")
}

model OptimizationProposal {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId    String   @map("workspace_id") @db.Uuid
  targetArea     String   @map("target_area")
  originalConfig Json     @default("{}") @map("original_config")
  proposedConfig Json     @default("{}") @map("proposed_config")
  testSuiteId    String?  @map("test_suite_id") @db.Uuid
  metricDelta    Json     @default("{}") @map("metric_delta")
  status         String   @default("PENDING_APPROVAL") // PENDING_APPROVAL | APPROVED | REJECTED
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  workspace      Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  testSuite      TestSuite? @relation(fields: [testSuiteId], references: [id], onDelete: SetNull)

  @@map("optimization_proposals")
}

model CommitteeMemo {
  id                        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId               String   @map("workspace_id") @db.Uuid
  propertyId                String   @map("property_id") @db.Uuid
  memoVersion               String   @map("memo_version")
  contentJson               Json     @map("content_json")
  complianceMismatchesJson  Json     @map("compliance_mismatches_json")
  generatedByUserId         String   @map("generated_by_user_id") @db.Uuid
  inputSourcesJson          Json     @map("input_sources_json")
  status                    String   @default("draft")
  signedOffByUserId         String?  @map("signed_off_by_user_id") @db.Uuid
  signedOffAt               DateTime? @map("signed_off_at") @db.Timestamptz
  createdAt                 DateTime @default(now()) @map("created_at") @db.Timestamptz

  workspace                 Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  property                  Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("committee_memos")
  @@index([workspaceId, propertyId])
}

