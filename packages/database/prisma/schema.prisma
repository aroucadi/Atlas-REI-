datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgcrypto, postgis, vector]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

model Organization {
  id              String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  slug            String                   @unique
  planTier        String                   @default("starter") @map("plan_tier")
  defaultCurrency String                   @default("USD") @db.Char(3) @map("default_currency")
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  memberships     OrganizationMembership[]
  workspaces      Workspace[]
  auditLogs       AuditLog[]

  @@map("organizations")
}

model User {
  id              String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String                   @unique
  fullName        String                   @map("full_name")
  authProvider    String                   @map("auth_provider")
  passwordHash    String?                  @map("password_hash")
  status          String                   @default("active")
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  memberships     OrganizationMembership[] @relation("UserMemberships")
  invitedMembers  OrganizationMembership[] @relation("InvitedByUser")
  workspaces      Workspace[]              @relation("CreatedByUser")
  auditLogs       AuditLog[]
  investorProfiles InvestorProfile[]
  savedSearches   SavedSearch[]
  shortlists      Shortlist[]
  decisions       InvestmentDecision[]
  portfolios      Portfolio[]

  @@map("users")
}

model OrganizationMembership {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  role           String
  status         String       @default("active")
  invitedByUserId String?     @map("invited_by_user_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation("UserMemberships", fields: [userId], references: [id], onDelete: Cascade)
  invitedByUser  User?        @relation("InvitedByUser", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@unique([organizationId, userId])
  @@map("organization_memberships")
}

model Workspace {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String               @map("organization_id") @db.Uuid
  name           String
  workspaceType  String               @default("investment") @map("workspace_type")
  createdByUserId String?             @map("created_by_user_id") @db.Uuid
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdByUser  User?                @relation("CreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)
  auditLogs      AuditLog[]
  profiles       InvestorProfile[]
  savedSearches  SavedSearch[]
  shortlists     Shortlist[]
  decisions      InvestmentDecision[]
  dailyBriefs    DailyBrief[]
  portfolios     Portfolio[]
  jobs           Job[]
  aiRuns         AiRun[]
  documents      Document[]
  underwriteRuns UnderwriteRun[]
  evidence       Evidence[]
  goals          Goal[]
  entityNodes    EntityNode[]
  entityRelationships EntityRelationship[]
  agentMessages  AgentMessage[]
  kernelProcesses KernelProcess[]
  optimizationProposals OptimizationProposal[]
  committeeMemos CommitteeMemo[]

  @@map("workspaces")
}

model AuditLog {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String?       @map("organization_id") @db.Uuid
  workspaceId    String?       @map("workspace_id") @db.Uuid
  actorUserId    String?       @map("actor_user_id") @db.Uuid
  entityType     String        @map("entity_type")
  entityId       String        @map("entity_id")
  action         String
  beforeJson     Json?         @map("before_json")
  afterJson      Json?         @map("after_json")
  previousHash   String?       @map("previous_hash")
  entryHash      String?       @unique @map("entry_hash")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace      Workspace?    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actorUser      User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model CountryPack {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  countryCode        String          @unique @db.Char(2) @map("country_code")
  name               String
  status             String          @default("active")
  baseCurrency       String          @db.Char(3) @map("base_currency")
  timezone           String
  supportsResidential Boolean        @default(true) @map("supports_residential")
  supportsCommercial  Boolean        @default(false) @map("supports_commercial")
  configJson         Json            @default("{}") @map("config_json")
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  cities             CityPack[]
  sources            SourcePack[]
  scoreTemplates     ScoreTemplate[]
  forecastTemplates  ForecastTemplate[]
  listingSources     ListingSource[]
  scoreSnapshots     ScoreSnapshot[]

  @@map("country_packs")
}

model CityPack {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  countryPackId String      @map("country_pack_id") @db.Uuid
  cityCode      String      @map("city_code")
  name          String
  configJson    Json        @default("{}") @map("config_json")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  countryPack   CountryPack @relation(fields: [countryPackId], references: [id], onDelete: Cascade)

  @@unique([countryPackId, cityCode])
  @@map("city_packs")
}

model SourcePack {
  id                String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  countryPackId     String      @map("country_pack_id") @db.Uuid
  sourceName        String      @map("source_name")
  sourceType        String      @map("source_type")
  connectorType     String      @map("connector_type")
  authConfigJson    Json        @default("{}") @map("auth_config_json")
  mappingConfigJson Json        @default("{}") @map("mapping_config_json")
  refreshPolicyJson Json        @default("{}") @map("refresh_policy_json")
  status            String      @default("active")
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  countryPack       CountryPack @relation(fields: [countryPackId], references: [id], onDelete: Cascade)

  @@unique([countryPackId, sourceName])
  @@map("source_packs")
}

model ScoreTemplate {
  id                    String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  countryPackId         String      @map("country_pack_id") @db.Uuid
  scoreKey              String      @map("score_key")
  version               Int
  formulaJson           Json        @map("formula_json")
  weightingJson         Json        @default("{}") @map("weighting_json")
  missingDataPolicyJson Json        @default("{}") @map("missing_data_policy_json")
  status                String      @default("draft")
  createdAt             DateTime    @default(now()) @map("created_at") @db.Timestamptz
  countryPack           CountryPack @relation(fields: [countryPackId], references: [id], onDelete: Cascade)

  @@unique([countryPackId, scoreKey, version])
  @@map("score_templates")
}

model ForecastTemplate {
  id                   String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  countryPackId        String      @map("country_pack_id") @db.Uuid
  forecastKey          String      @map("forecast_key")
  version              Int
  modelPolicyJson      Json        @default("{}") @map("model_policy_json")
  featurePolicyJson    Json        @default("{}") @map("feature_policy_json")
  confidencePolicyJson Json        @default("{}") @map("confidence_policy_json")
  status               String      @default("draft")
  createdAt            DateTime    @default(now()) @map("created_at") @db.Timestamptz
  countryPack          CountryPack @relation(fields: [countryPackId], references: [id], onDelete: Cascade)

  @@unique([countryPackId, forecastKey, version])
  @@map("forecast_templates")
}

model Country {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  countryCode  String      @unique @db.Char(2) @map("country_code")
  name         String
  currencyCode String      @db.Char(3) @map("currency_code")
  region       String?
  geom         Unsupported("geometry(MultiPolygon, 4326)")?
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  cities       City[]
  developers   Developer[]
  properties   Property[]

  @@map("countries")
}

model City {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  countryId   String      @map("country_id") @db.Uuid
  cityCode    String      @map("city_code")
  name        String
  timezone    String
  geom        Unsupported("geometry(MultiPolygon, 4326)")?
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  country     Country     @relation(fields: [countryId], references: [id], onDelete: Cascade)
  districts   District[]
  projects    Project[]
  buildings   Building[]
  properties  Property[]

  @@unique([countryId, cityCode])
  @@map("cities")
}

model District {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cityId           String        @map("city_id") @db.Uuid
  districtCode     String        @map("district_code")
  name             String
  districtType     String        @default("district") @map("district_type")
  parentDistrictId String?       @map("parent_district_id") @db.Uuid
  geom             Unsupported("geometry(MultiPolygon, 4326)")?
  metadataJson     Json          @default("{}") @map("metadata_json")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  city             City          @relation(fields: [cityId], references: [id], onDelete: Cascade)
  parentDistrict   District?     @relation("DistrictHierarchy", fields: [parentDistrictId], references: [id], onDelete: SetNull)
  subDistricts     District[]    @relation("DistrictHierarchy")
  microMarkets     MicroMarket[]
  projects         Project[]
  buildings        Building[]
  properties       Property[]
  saleTransactions SaleTransaction[]
  rentalTransactions RentalTransaction[]

  @@unique([cityId, districtCode])
  @@map("districts")
}

model MicroMarket {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  districtId   String      @map("district_id") @db.Uuid
  name         String
  geom         Unsupported("geometry(MultiPolygon, 4326)")?
  metadataJson Json        @default("{}") @map("metadata_json")
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  district     District    @relation(fields: [districtId], references: [id], onDelete: Cascade)
  buildings    Building[]

  @@unique([districtId, name])
  @@map("micro_markets")
}

model Developer {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  countryId      String?     @map("country_id") @db.Uuid
  name           String
  normalizedName String      @map("normalized_name")
  developerType  String?     @map("developer_type")
  websiteUrl     String?     @map("website_url")
  metadataJson   Json        @default("{}") @map("metadata_json")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  country        Country?    @relation(fields: [countryId], references: [id], onDelete: SetNull)
  projects       Project[]
  buildings      Building[]

  @@map("developers")
}

model Project {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  developerId    String?     @map("developer_id") @db.Uuid
  cityId         String      @map("city_id") @db.Uuid
  districtId     String?     @map("district_id") @db.Uuid
  name           String
  projectType    String?     @map("project_type")
  status         String?
  launchDate     DateTime?   @map("launch_date") @db.Date
  completionDate DateTime?   @map("completion_date") @db.Date
  geom           Unsupported("geometry(MultiPolygon, 4326)")?
  metadataJson   Json        @default("{}") @map("metadata_json")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  developer      Developer?  @relation(fields: [developerId], references: [id], onDelete: SetNull)
  city           City        @relation(fields: [cityId], references: [id], onDelete: Cascade)
  district       District?   @relation(fields: [districtId], references: [id], onDelete: SetNull)
  buildings      Building[]
  properties     Property[]

  @@map("projects")
}

model Building {
  id                  String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId           String?                @map("project_id") @db.Uuid
  developerId         String?                @map("developer_id") @db.Uuid
  cityId              String                 @map("city_id") @db.Uuid
  districtId          String?                @map("district_id") @db.Uuid
  microMarketId       String?                @map("micro_market_id") @db.Uuid
  name                String
  normalizedName      String                 @map("normalized_name")
  buildingType        String?                @map("building_type")
  status              String?
  handoverDate        DateTime?              @map("handover_date") @db.Date
  floorsCount         Int?                   @map("floors_count")
  unitCount           Int?                   @map("unit_count")
  geom                Unsupported("geometry(Point, 4326)")?
  metadataJson        Json                   @default("{}") @map("metadata_json")
  createdAt           DateTime               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  project             Project?               @relation(fields: [projectId], references: [id], onDelete: SetNull)
  developer           Developer?             @relation(fields: [developerId], references: [id], onDelete: SetNull)
  city                City                   @relation(fields: [cityId], references: [id], onDelete: Cascade)
  district            District?              @relation(fields: [districtId], references: [id], onDelete: SetNull)
  microMarket         MicroMarket?           @relation(fields: [microMarketId], references: [id], onDelete: SetNull)
  properties          Property[]
  saleTransactions    SaleTransaction[]
  rentalTransactions  RentalTransaction[]
  serviceChargeRecords ServiceChargeRecord[]

  @@map("buildings")
}

model Property {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  buildingId          String?             @map("building_id") @db.Uuid
  projectId           String?             @map("project_id") @db.Uuid
  cityId              String              @map("city_id") @db.Uuid
  districtId          String?             @map("district_id") @db.Uuid
  countryId           String?             @map("country_id") @db.Uuid
  externalPropertyRef String?             @map("external_property_ref")
  propertyType        String              @map("property_type")
  bedrooms            Int?
  bathrooms           Int?
  interiorAreaSqm     Decimal?            @map("interior_area_sqm") @db.Decimal(12, 2)
  exteriorAreaSqm     Decimal?            @map("exterior_area_sqm") @db.Decimal(12, 2)
  floorNumber         Int?                @map("floor_number")
  tenureType          String?             @map("tenure_type")
  ownershipType       String?             @map("ownership_type")
  furnishingStatus    String?             @map("furnishing_status")
  occupancyStatus     String?             @map("occupancy_status")
  geom                Unsupported("geometry(Point, 4326)")?
  metadataJson        Json                @default("{}") @map("metadata_json")
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  building            Building?           @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  project             Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  city                City                @relation(fields: [cityId], references: [id], onDelete: Cascade)
  district            District?           @relation(fields: [districtId], references: [id], onDelete: SetNull)
  country             Country?            @relation(fields: [countryId], references: [id], onDelete: SetNull)
  listings            Listing[]
  saleTransactions    SaleTransaction[]
  rentalTransactions  RentalTransaction[]
  portfolioPositions  PortfolioPosition[]
  underwriteRuns      UnderwriteRun[]
  evidence            Evidence[]
  committeeMemos      CommitteeMemo[]

  @@map("properties")
}

model ListingSource {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  countryPackId String?     @map("country_pack_id") @db.Uuid
  name          String      @unique
  sourceType    String      @map("source_type")
  status        String      @default("active")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  countryPack   CountryPack? @relation(fields: [countryPackId], references: [id], onDelete: Cascade)
  listings      Listing[]

  @@map("listing_sources")
}

model Listing {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  propertyId        String?       @map("property_id") @db.Uuid
  listingSourceId   String        @map("listing_source_id") @db.Uuid
  externalListingId String        @map("external_listing_id")
  listingType       String        @map("listing_type")
  listingStatus     String        @map("listing_status")
  url               String?
  priceAmount       Decimal?      @map("price_amount") @db.Decimal(14, 2)
  priceCurrency     String?       @db.Char(3) @map("price_currency")
  rentFrequency     String?       @map("rent_frequency")
  listedAt          DateTime?     @map("listed_at") @db.Timestamptz
  removedAt         DateTime?     @map("removed_at") @db.Timestamptz
  brokerName        String?       @map("broker_name")
  brokerCompany     String?       @map("broker_company")
  rawAttributesJson Json          @default("{}") @map("raw_attributes_json")
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  property          Property?     @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  listingSource     ListingSource @relation(fields: [listingSourceId], references: [id], onDelete: Cascade)
  media             ListingMedia[]

  @@unique([listingSourceId, externalListingId])
  @@map("listings")
}

model ListingMedia {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  listingId String   @map("listing_id") @db.Uuid
  mediaType String   @map("media_type")
  url       String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@map("listing_media")
}

model SaleTransaction {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  propertyId       String?   @map("property_id") @db.Uuid
  buildingId       String?   @map("building_id") @db.Uuid
  districtId       String?   @map("district_id") @db.Uuid
  sourceName       String    @map("source_name")
  transactionDate  DateTime  @map("transaction_date") @db.Date
  priceAmount      Decimal   @map("price_amount") @db.Decimal(14, 2)
  priceCurrency    String    @db.Char(3) @map("price_currency")
  pricePerSqm      Decimal?  @map("price_per_sqm") @db.Decimal(14, 2)
  buyerType        String?   @map("buyer_type")
  sellerType       String?   @map("seller_type")
  isNewSale        Boolean?  @map("is_new_sale")
  isOffPlan        Boolean?  @map("is_off_plan")
  sourceRecordId   String?   @map("source_record_id")
  sourceConfidence Decimal?  @map("source_confidence") @db.Decimal(5, 2)
  rawRecordJson    Json      @default("{}") @map("raw_record_json")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  property         Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  building         Building? @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  district         District? @relation(fields: [districtId], references: [id], onDelete: SetNull)

  @@map("sale_transactions")
}

model RentalTransaction {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  propertyId        String?   @map("property_id") @db.Uuid
  buildingId        String?   @map("building_id") @db.Uuid
  districtId        String?   @map("district_id") @db.Uuid
  contractStartDate DateTime? @map("contract_start_date") @db.Date
  contractEndDate   DateTime? @map("contract_end_date") @db.Date
  annualRentAmount  Decimal   @map("annual_rent_amount") @db.Decimal(14, 2)
  rentCurrency      String    @db.Char(3) @map("rent_currency")
  rentFrequency     String?   @map("rent_frequency")
  sourceName        String    @map("source_name")
  sourceRecordId    String?   @map("source_record_id")
  sourceConfidence  Decimal?  @map("source_confidence") @db.Decimal(5, 2)
  rawRecordJson     Json      @default("{}") @map("raw_record_json")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  property          Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  building          Building? @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  district          District? @relation(fields: [districtId], references: [id], onDelete: SetNull)

  @@map("rental_transactions")
}

model ServiceChargeRecord {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  buildingId     String   @map("building_id") @db.Uuid
  effectiveYear  Int      @map("effective_year")
  chargePerSqm   Decimal  @map("charge_per_sqm") @db.Decimal(12, 2)
  currency       String   @db.Char(3)
  sourceName     String   @map("source_name")
  sourceRecordId String?  @map("source_record_id")
  confidence     Decimal? @db.Decimal(5, 2)
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  building       Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  @@unique([buildingId, effectiveYear, sourceName])
  @@map("service_charge_records")
}

model SourceRecord {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceName       String             @map("source_name")
  sourceEntityType String             @map("source_entity_type")
  sourceRecordId   String             @map("source_record_id")
  rawStoragePath   String             @map("raw_storage_path")
  capturedAt       DateTime           @default(now()) @map("captured_at") @db.Timestamptz
  checksum         String?
  metadataJson     Json               @default("{}") @map("metadata_json")
  links            EntitySourceLink[]

  @@unique([sourceName, sourceEntityType, sourceRecordId])
  @@map("source_records")
}

model EntitySourceLink {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityType        String       @map("entity_type")
  entityId          String       @map("entity_id")
  sourceRecordId    String       @map("source_record_id") @db.Uuid
  mappingConfidence Decimal?     @map("mapping_confidence") @db.Decimal(5, 2)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz
  sourceRecord      SourceRecord @relation(fields: [sourceRecordId], references: [id], onDelete: Cascade)

  @@map("entity_source_links")
}

model DataFreshness {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceName     String    @map("source_name")
  marketScope    String?   @map("market_scope")
  entityScope    String?   @map("entity_scope")
